{
  "name": "@helix-heal/github-action",
  "version": "0.1.0",
  "description": "GitHub Action wrapper for Helix Heal.",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --packages=bundle --outfile=dist/index.cjs",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@helix-heal/core": "0.1.0",
    "@helix-heal/playwright-ingest": "0.1.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.5"
  }
}
